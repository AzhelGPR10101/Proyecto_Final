# Copia este archivo, renombralo a "config.properties" (sin .example),
# y coloca ahi tu correo y tu contraseña de aplicacion de Gmail reales.
# config.properties NUNCA se sube al repositorio (esta en .gitignore).
#
# Como conseguir una "contraseña de aplicacion" de Gmail:
# 1. Activa la verificacion en 2 pasos en tu cuenta de Google.
# 2. Ve a https://myaccount.google.com/apppasswords
# 3. Genera una contraseña nueva para "Correo" / "Otra app".
# 4. Pega esa contraseña de 16 caracteres abajo (no la de tu cuenta normal).

correo.remitente=tu_correo@gmail.com
correo.clave=tu_contrasena_de_aplicacion_de_16_caracteres

# Conexion a la base de datos PostgreSQL.
# Para desarrollo local (Postgres en tu PC) deja host=localhost y sslmode=disable.
# Para Neon (u otro proveedor en la nube) usa el connection string que te dieron
# y pon sslmode=require.
db.host=localhost
db.port=5432
db.name=KryptonBase
db.user=postgres
db.password=tu_password
db.sslmode=disable
